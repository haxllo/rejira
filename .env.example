# ─── Supabase ────────────────────────────────────────────────────────────
# Public Supabase config (anon/publishable key + URL) — used by Realtime + Storage clients
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Also accepted: NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (newer alias for the anon key)

# Server-only service role key — NEVER expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transaction-mode pooler (port 6543) — used by Drizzle in the app
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Direct connection (port 5432) — used by drizzle-kit migrations only (never pooled)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Session-mode pooler (port 5432) — used by Better Auth (Phase 3) for long-lived prepared statements
DATABASE_URL_SESSION=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── Better Auth (Phase 3) ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=

# Skip email verification in dev (set to "true" for faster local iteration)
# Only respected when NODE_ENV !== 'production'
DEV_SKIP_EMAIL_VERIFICATION=true

# ─── OAuth (Phase 3 — optional) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Email (Phase 3) ────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Rejira <noreply@rejira.app>
RESEND_WEBHOOK_SECRET=

# ─── Rate limiting (Phase 3) ─────────────────────────────────────────────
# Upstash Redis (prod); in-memory fallback in dev
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Observability (Phase 4J) ────────────────────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ─── Optional: HIBP (HaveIBeenPwned) for password breach check ───────────
HIBP_API_KEY=
