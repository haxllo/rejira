{
  "name": "jira-redesign",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "bootstrap": "supabase start && supabase db reset && npm --prefix apps/web run dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "supabase db pull",
    "db:diff": "supabase db diff",
    "db:studio": "supabase studio",
    "db:types": "supabase gen types typescript --local > apps/web/lib/supabase/database.types.ts",
    "db:seed": "tsx apps/web/lib/db/seed.ts",
    "db:lint": "supabase db lint",
    "db:test": "vitest run --config apps/web/vitest.config.ts -t 'auth|db'",
    "db:push:staging": "supabase db push --project-ref <staging-ref>",
    "db:push:prod": "supabase db push --project-ref <prod-ref>",
    "db:branch:create": "supabase branches create <branch-name>",
    "db:branch:delete": "supabase branches delete <branch-name>",
    "db:branch:list": "supabase branches list",
    "auth:generate": "npx @better-auth/cli@latest generate",
    "auth:migrate": "npx @better-auth/cli@latest migrate",
    "test": "vitest run --config apps/web/vitest.config.ts",
    "test:watch": "vitest --config apps/web/vitest.config.ts",
    "test:coverage": "vitest run --config apps/web/vitest.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep 'a11y'",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "workspaces": [
    "apps/*"
  ],
  "dependencies": {
    "@jridgewell/sourcemap-codec": "^1.6.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/postcss": "^4.3.0",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.0",
    "pg": "^8.13.0",
    "postgres": "^3.4.5",
    "react-email": "^4.0.0",
    "resend": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.19.20",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
